generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                      @id @default(uuid())
  registerNo             String?                     @unique
  name                   String
  email                  String                      @unique
  passwordHash           String?
  googleId               String?
  role                   Role                        @default(STUDENT)
  department             String
  year                   Int?
  semester               Int?
  section                String?
  avatar                 String?
  sessionId              String?
  fingerprint            String?
  // Faculty-only: whether this faculty member is allowed to create/finalize examination papers.
  // Granted explicitly by an Admin — off by default, meaningless for other roles.
  canCreateExams         Boolean                     @default(false)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  aiBatchJobs            AIBatchGenerationJob[]
  aiConversations        AIConversation[]
  aiDocuments            AIDocument[]
  aiExamAssemblyTraces   AIExamAssemblyTrace[]       @relation("CreatedAIExamAssemblyTraces")
  aiFeedbacks            AIFeedback[]
  aiGeneratedQuestions   AIGeneratedQuestion[]       @relation("CreatedAIGeneratedQuestions")
  aiPracticeAttempts     AIPracticeAttempt[]
  aiQuestionTraces       AIQuestionGenerationTrace[] @relation("CreatedAIQuestionTraces")
  ragTraces              AIRAGTrace[]
  aiSolutions            AISolution[]                @relation("CreatedAISolutions")
  auditLogs              AuditLog[]
  invigilatorAssignments InvigilatorAssignment[]
  createdTests           MockTest[]                  @relation("CreatedBy")
  questions              Question[]                  @relation("CreatedQuestions")
  assignments            TestAssignment[]
}

model Subject {
  id         String   @id @default(uuid())
  name       String
  code       String   @unique
  department String
  modules    Module[]
}

model Module {
  id        String  @id @default(uuid())
  name      String
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics    Topic[]
}

model Topic {
  id        String     @id @default(uuid())
  name      String
  moduleId  String
  subtopics Subtopic[]
  module    Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model Subtopic {
  id                   String                @id @default(uuid())
  name                 String
  topicId              String
  aiGeneratedQuestions AIGeneratedQuestion[]
  questions            Question[]
  topic                Topic                 @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model Question {
  id                 String                  @id @default(uuid())
  text               String
  type               QuestionType
  difficulty         Difficulty              @default(MEDIUM)
  marks              Float                   @default(1.0)
  negativeMarks      Float                   @default(0.33)
  options            Json
  correctAnswer      Json
  explanation        String?
  reference          String?
  previousYear       String?
  imageUrl           String?
  subtopicId         String
  createdById        String
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  generatedByAI      Boolean                 @default(false)
  generationModel    String?
  reviewStatus       AIQuestionReviewStatus?
  customId           String?                 @unique
  rawAnswer          String?
  containsFigure     Boolean                 @default(false)
  textExtractionUsed Boolean                 @default(true)
  visualExtractionUsed Boolean               @default(false)
  visualMetadata     Json?
  origin             QuestionOrigin          @default(SOURCE)
  verificationStatus VerificationStatus      @default(VERIFIED)
  sourceDocumentId   String?
  sourcePage         Int?
  sourceChapter      String?
  sourceSection      String?
  sourceHeading      String?
  currentVersion     Int                     @default(1)
  embedding          Float[]
  embeddingModel     String?
  aiSolutions        AISolution[]
  mockTestQuestions  MockTestQuestion[]
  createdBy          User                    @relation("CreatedQuestions", fields: [createdById], references: [id])
  subtopic           Subtopic                @relation(fields: [subtopicId], references: [id])
  sourceDocument     AIDocument?             @relation("DocumentQuestions", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  aiSources          QuestionAISource[]
  responses          QuestionResponse[]
  versions           QuestionVersion[]

  @@index([subtopicId])
  @@index([verificationStatus])
  @@index([origin])
  @@index([type])
  @@index([difficulty])
  @@index([sourceDocumentId])
  @@index([customId])
}

// Immutable point-in-time snapshot of a Question's gradable content. Created whenever the
// answer/options/text/marks change (see questionVersionService.ts). MockTestQuestion pins the
// version active at exam-assembly time, so scoring/solution-review never drift when the live
// Question row is edited later — see examController.ts submitExam/getSolutionReview.
model QuestionVersion {
  id                String             @id @default(uuid())
  questionId        String
  versionNumber     Int
  text              String
  type              QuestionType
  difficulty        Difficulty
  marks             Float
  negativeMarks     Float
  options           Json
  correctAnswer     Json
  explanation       String?
  imageUrl          String?
  createdAt         DateTime           @default(now())
  createdById       String?
  question          Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  mockTestQuestions MockTestQuestion[]

  @@unique([questionId, versionNumber])
  @@index([questionId])
}

model MockTest {
  id                 String                  @id @default(uuid())
  title              String
  description        String?
  examType           ExamType                @default(SCHEDULED)
  durationMinutes    Int                     @default(180)
  totalMarks         Float                   @default(100.0)
  startTime          DateTime
  endTime            DateTime
  targetDepartment   String
  targetYear         Int?
  targetSection      String?
  isPublished        Boolean                 @default(false)
  resultVisibility   ResultVisibility        @default(AFTER_EXAM_ENDS)
  // Only meaningful when resultVisibility = MANUAL_PUBLISH: results stay hidden from students
  // until a Faculty/Admin explicitly flips this, regardless of exam status or endTime.
  resultsPublished   Boolean                 @default(false)
  solutionVisibility SolutionVisibility      @default(SHOW_AFTER_RESULT)
  shuffleQuestions   Boolean                 @default(true)
  shuffleOptions     Boolean                 @default(true)
  maxViolations      Int                     @default(5)
  instructions       String?
  createdById        String
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  status             ExamStatus              @default(DRAFT)
  aiExamTrace        AIExamAssemblyTrace?
  invigilators       InvigilatorAssignment[]
  createdBy          User                    @relation("CreatedBy", fields: [createdById], references: [id])
  testQuestions      MockTestQuestion[]
  assignments        TestAssignment[]

  @@index([createdById])
  @@index([status])
}

model MockTestQuestion {
  id                String           @id @default(uuid())
  mockTestId        String
  questionId        String
  questionVersionId String?
  order             Int              @default(1)
  mockTest          MockTest         @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  question          Question         @relation(fields: [questionId], references: [id])
  questionVersion   QuestionVersion? @relation(fields: [questionVersionId], references: [id])

  @@unique([mockTestId, questionId])
}

model TestAssignment {
  id             String             @id @default(uuid())
  testId         String
  studentId      String
  status         String             @default("SCHEDULED")
  score          Float?
  totalMarks     Float?
  accuracy       Float?
  timeTakenSec   Int                @default(0)
  riskLevel      RiskLevel          @default(SAFE)
  violationCount Int                @default(0)
  startedAt      DateTime?
  submittedAt    DateTime?
  responses      QuestionResponse[]
  student        User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test           MockTest           @relation(fields: [testId], references: [id], onDelete: Cascade)
  violations     ViolationLog[]

  @@index([testId])
}

model QuestionResponse {
  id            String         @id @default(uuid())
  assignmentId  String
  questionId    String
  chosenAnswer  Json?
  status        String         @default("NOT_VISITED")
  isCorrect     Boolean        @default(false)
  marksObtained Float          @default(0.0)
  timeSpentSec  Int            @default(0)
  updatedAt     DateTime       @updatedAt
  assignment    TestAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  question      Question       @relation(fields: [questionId], references: [id])

  @@unique([assignmentId, questionId])
}

model ViolationLog {
  id           String         @id @default(uuid())
  assignmentId String
  type         String
  timestamp    DateTime       @default(now())
  details      String?
  assignment   TestAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String
  ipAddress String?
  details   String?
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("info")
  userId    String?
  role      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AIConversation {
  id        String       @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIMessage[]
  ragTraces AIRAGTrace[]
}

model AIMessage {
  id                  String          @id @default(uuid())
  conversationId      String
  role                AIMessageRole
  content             String
  createdAt           DateTime        @default(now())
  requestId           String?         @unique
  parentUserMessageId String?         @unique
  processingStartedAt DateTime?
  status              AIRequestStatus @default(COMPLETED)
  feedbacks           AIFeedback[]
  conversation        AIConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parentUserMessage   AIMessage?      @relation("UserToAssistantMessage", fields: [parentUserMessageId], references: [id], onDelete: Cascade)
  assistantMessage    AIMessage?      @relation("UserToAssistantMessage")
  assistantTraces     AIRAGTrace[]    @relation("AssistantMessageTrace")
  userTraces          AIRAGTrace[]    @relation("UserMessageTrace")
}

model AIDocument {
  id                       String                 @id @default(uuid())
  title                    String
  fileName                 String
  mimeType                 String
  fileSize                 Int?
  visibility               AIDocumentVisibility
  status                   AIDocumentStatus       @default(UPLOADED)
  storageKey               String                 @unique
  uploadedById             String
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  metadata                 Json?
  processedAt              DateTime?
  processingError          String?
  subjectId                String?
  moduleId                 String?
  topicId                  String?
  subtopicId               String?
  classificationConfidence Float?
  classificationStatus     String?                @default("REQUIRES_CLASSIFICATION")
  ocrStatus                String?                @default("NONE")
  uploadedBy               User                   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  chunks                   AIDocumentChunk[]
  aiSources                QuestionAISource[]
  questions                Question[]             @relation("DocumentQuestions")
  pages                    DocumentPage[]
  extractedQuestions       ExtractedQuestion[]
  extractedAnswers         ExtractedAnswer[]
  processingJob            DocumentProcessingJob?

  @@index([status])
  @@index([visibility])
  @@index([uploadedById])
}

// One row per page of an uploaded document, with its extraction method and structural
// classification (theory/question/answer-key/etc) — the foundation the question/answer-key
// extraction and mapping below is built on. Dynamically discovered per document; never assumes
// a fixed page range for any section.
model DocumentPage {
  id                       String              @id @default(uuid())
  documentId               String
  pageNumber               Int
  rawText                  String?             @db.Text
  extractionMethod         String // 'TEXT_LAYER' | 'VISION_OCR'
  pageType                 String? // 'THEORY' | 'QUESTION' | 'ANSWER_KEY' | 'REFERENCE' | 'APPENDIX' | 'UNKNOWN'
  classificationConfidence Float?
  createdAt                DateTime            @default(now())
  document                 AIDocument          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  extractedQuestions       ExtractedQuestion[]
  extractedAnswers         ExtractedAnswer[]

  @@unique([documentId, pageNumber])
  @@index([documentId])
  @@index([pageType])
}

// A question found in the source document, with its identifier exactly as printed (e.g.
// "1.1.10(a)") and a normalized form used for deterministic matching against ExtractedAnswer —
// never matched by page proximity.
model ExtractedQuestion {
  id                   String           @id @default(uuid())
  documentId           String
  rawQuestionId        String
  normalizedQuestionId String
  questionText         String           @db.Text
  options              Json?
  questionType         String? // 'MCQ' | 'MSQ' | 'NAT' | 'UNKNOWN'
  sourcePageId         String
  imageRefs            String[]
  answerMappingStatus  String           @default("PENDING") // PENDING | MAPPED | ANSWER_MAPPING_UNCERTAIN | NO_ANSWER_FOUND
  mappedAnswerId       String?
  extractionConfidence Float?
  createdAt            DateTime         @default(now())
  document             AIDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sourcePage           DocumentPage     @relation(fields: [sourcePageId], references: [id], onDelete: Cascade)
  mappedAnswer         ExtractedAnswer? @relation(fields: [mappedAnswerId], references: [id])

  @@index([documentId])
  @@index([normalizedQuestionId])
  @@index([answerMappingStatus])
}

// An answer-key entry found in the source document (often hundreds of pages away from its
// question), keyed by the same normalized identifier scheme as ExtractedQuestion.
model ExtractedAnswer {
  id                   String              @id @default(uuid())
  documentId           String
  rawQuestionId        String
  normalizedQuestionId String
  answerValue          Json
  explanation          String?             @db.Text
  sourcePageId         String
  createdAt            DateTime            @default(now())
  document             AIDocument          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sourcePage           DocumentPage        @relation(fields: [sourcePageId], references: [id], onDelete: Cascade)
  mappedQuestions      ExtractedQuestion[]

  @@index([documentId])
  @@index([normalizedQuestionId])
}

// Real, pollable progress state for the async document-structure pipeline (in-process DB-polled
// worker — see documentProcessingWorker.ts). Mirrors the AIBatchGenerationJob pattern already
// used for question generation, applied to document processing instead.
model DocumentProcessingJob {
  id                String     @id @default(uuid())
  documentId        String     @unique
  status            String     @default("QUEUED") // QUEUED | EXTRACTING | OCR | STRUCTURING | INDEXING | CLASSIFYING | MAPPING | COMPLETED | FAILED
  statusMessage     String?
  totalPages        Int?
  pagesProcessed    Int        @default(0)
  questionsFound    Int        @default(0)
  answersFound      Int        @default(0)
  mappingsResolved  Int        @default(0)
  mappingsUncertain Int        @default(0)
  error             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  document          AIDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model AIDocumentChunk {
  id         String     @id @default(uuid())
  documentId String
  chunkIndex Int
  content    String
  createdAt  DateTime   @default(now())
  embedding  Float[]
  metadata   Json?
  tokenCount Int?
  document   AIDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model AIRAGTrace {
  id                        String                      @id @default(uuid())
  requestId                 String?                     @unique
  conversationId            String
  userId                    String
  userMessageId             String?
  assistantMessageId        String?
  ragDecision               AIRAGDecision
  ragUsed                   Boolean                     @default(false)
  status                    AIRAGTraceStatus            @default(PROCESSING)
  embeddingDurationMs       Int                         @default(0)
  vectorSearchDurationMs    Int                         @default(0)
  contextAssemblyDurationMs Int                         @default(0)
  providerDurationMs        Int                         @default(0)
  totalDurationMs           Int                         @default(0)
  authorizedChunksFound     Int                         @default(0)
  relevantChunksUsed        Int                         @default(0)
  sourceDocumentCount       Int                         @default(0)
  qualityScore              Float?
  qualityClassification     AIRAGQualityClassification?
  fallbackReason            String?
  errorCode                 String?
  createdAt                 DateTime                    @default(now())
  assistantMessage          AIMessage?                  @relation("AssistantMessageTrace", fields: [assistantMessageId], references: [id], onDelete: Cascade)
  conversation              AIConversation              @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user                      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userMessage               AIMessage?                  @relation("UserMessageTrace", fields: [userMessageId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([userId])
  @@index([createdAt])
  @@index([status])
  @@index([ragUsed])
}

model AIFeedback {
  id        String              @id @default(uuid())
  messageId String
  userId    String
  rating    AIFeedbackRating
  category  AIFeedbackCategory?
  comment   String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  message   AIMessage           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model AIGeneratedQuestion {
  id                  String                     @id @default(uuid())
  generationRequestId String?
  stem                String
  type                QuestionType
  difficulty          Difficulty                 @default(MEDIUM)
  marks               Float                      @default(1.0)
  negativeMarks       Float                      @default(0.33)
  options             Json?
  correctAnswer       Json
  explanation         String?
  generatedAnswer     Json?
  verifiedAnswer      Json?
  verificationStatus  String?                    @default("UNVERIFIED")
  sourcePageNumbers   Json?
  ambiguityDetected   Boolean                    @default(false)
  provenanceValid     Boolean                    @default(true)
  subjectId           String?
  moduleId            String?
  topicId             String?
  subtopicId          String?
  status              AIGeneratedQuestionStatus  @default(PENDING_REVIEW)
  qualityStatus       AIQuestionQualityStatus    @default(REVIEW)
  qualityScore        Float?
  similarityStatus    AIQuestionSimilarityStatus @default(UNIQUE)
  similarQuestionId   String?
  sourceDocumentIds   String[]
  sourceChunkIds      String[]
  createdQuestionId   String?                    @unique
  createdById         String
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  createdBy           User                       @relation("CreatedAIGeneratedQuestions", fields: [createdById], references: [id], onDelete: Cascade)
  subtopic            Subtopic?                  @relation(fields: [subtopicId], references: [id])

  @@index([status])
  @@index([createdById])
  @@index([generationRequestId])
}

model AIBatchGenerationJob {
  id                     String   @id @default(uuid())
  generationRequestId    String   @unique
  createdById            String
  // 'GENERATION' (default, existing RAG/AI batch question generation) | 'PDF_IMPORT' (extraction
  // of real questions from an uploaded PDF into the Question Bank, via the Phase 1 structure/
  // answer-mapping pipeline). Same job table/worker/polling infra serves both — see
  // batchGenerationWorker.ts's dispatch and pdfQuestionImportService.ts.
  jobType                String   @default("GENERATION")
  requestedCount         Int
  generatedCount         Int      @default(0)
  validatedCount         Int      @default(0)
  verifiedCount          Int      @default(0)
  pendingReviewCount     Int      @default(0)
  failedCount            Int      @default(0)
  duplicateCount         Int      @default(0)
  autoPublishedCount     Int      @default(0)
  regenerationRounds     Int      @default(0)
  status                 String   @default("QUEUED")
  statusMessage          String?
  difficultyDistribution Json?
  typeDistribution       Json?
  selectedResourceIds    String[]
  subjectId              String?
  moduleId               String?
  topicId                String?
  subtopicId             String?
  negativeMarking        Boolean  @default(true)
  solutionVisibility     String   @default("SHOW_AFTER_RESULT")
  sourceReferences       Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  createdBy              User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([status])
}

model AIQuestionGenerationTrace {
  id                     String        @id @default(uuid())
  generationRequestId    String        @unique
  generatedById          String
  subjectId              String?
  moduleId               String?
  topicId                String?
  subtopicId             String?
  questionType           QuestionType?
  requestedDifficulty    Difficulty?
  requestedCount         Int           @default(1)
  generatedCount         Int           @default(0)
  validationStatus       String?
  qualityStatus          String?
  sourceDocumentCount    Int           @default(0)
  sourceChunkCount       Int           @default(0)
  generationDurationMs   Int           @default(0)
  verificationDurationMs Int           @default(0)
  totalDurationMs        Int           @default(0)
  createdAt              DateTime      @default(now())
  generatedBy            User          @relation("CreatedAIQuestionTraces", fields: [generatedById], references: [id], onDelete: Cascade)

  @@index([generatedById])
  @@index([createdAt])
}

model AISolution {
  id                  String                       @id @default(uuid())
  questionId          String
  generationRequestId String                       @unique
  draftAnswer         Json
  draftExplanation    String
  verifiedAnswer      Json?
  verifiedExplanation String?
  status              AISolutionStatus             @default(PENDING_REVIEW)
  verificationStatus  AISolutionVerificationStatus @default(UNVERIFIED)
  qualityScore        Float?
  sourceDocumentIds   String[]
  sourceChunkIds      String[]
  generatedById       String
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  generatedBy         User                         @relation("CreatedAISolutions", fields: [generatedById], references: [id], onDelete: Cascade)
  question            Question                     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([status])
  @@index([generatedById])
}

model AIExamAssemblyTrace {
  id                           String            @id @default(uuid())
  examGenerationRequestId      String            @unique
  mockTestId                   String?           @unique
  generatedById                String
  subjectId                    String?
  requestedQuestionCount       Int
  selectedQuestionCount        Int
  requestedDifficulty          Json?
  actualDifficultyDistribution Json?
  topicCoverage                Json?
  status                       AIExamDraftStatus @default(DRAFT)
  validationStatus             String?
  assemblyDurationMs           Int               @default(0)
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt
  generatedBy                  User              @relation("CreatedAIExamAssemblyTraces", fields: [generatedById], references: [id], onDelete: Cascade)
  mockTest                     MockTest?         @relation(fields: [mockTestId], references: [id])

  @@index([generatedById])
  @@index([status])
  @@index([createdAt])
}

model QuestionAISource {
  id         String     @id @default(uuid())
  questionId String
  documentId String
  chunkId    String?
  createdAt  DateTime   @default(now())
  document   AIDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([documentId])
}

model AIPracticeAttempt {
  id            String     @id @default(uuid())
  studentId     String
  subject       String
  topic         String
  difficulty    Difficulty
  questionCount Int
  score         Float
  totalMarks    Float
  startedAt     DateTime   @default(now())
  completedAt   DateTime   @default(now())
  createdAt     DateTime   @default(now())
  student       User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model InvigilatorAssignment {
  id        String   @id @default(uuid())
  testId    String
  facultyId String
  createdAt DateTime @default(now())
  faculty   User     @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  test      MockTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, facultyId])
  @@index([testId])
  @@index([facultyId])
}

enum Role {
  STUDENT
  FACULTY
  ADMIN
}

enum ExamType {
  SCHEDULED
  PRACTICE
  ASSIGNMENT
  PREVIOUS_YEAR
  DEPARTMENT_TEST
}

enum QuestionType {
  MCQ
  MSQ
  NAT
  FREE_RESPONSE
  UNKNOWN
}

enum Difficulty {
  VERY_EASY
  EASY
  MEDIUM
  HARD
  VERY_HARD
}

enum ResultVisibility {
  IMMEDIATE
  AFTER_EXAM_ENDS
  MANUAL_PUBLISH
}

enum SolutionVisibility {
  HIDE_SOLUTIONS
  SHOW_ALWAYS
  SHOW_AFTER_RESULT
  SHOW_AFTER_EXAM_ENDS
}

enum RiskLevel {
  SAFE
  WARNING
  HIGH_RISK
}

enum AIMessageRole {
  USER
  ASSISTANT
}

enum AIRequestStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum AIDocumentVisibility {
  PUBLIC
  PRIVATE
  STUDENT
  FACULTY
  ADMIN
}

enum AIDocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum AIRAGDecision {
  USED
  SKIPPED_GENERAL_KNOWLEDGE
  SKIPPED_NO_DOCUMENTS
  RETRIEVAL_NO_RELEVANT
  FAILED
}

enum AIRAGTraceStatus {
  PROCESSING
  COMPLETED
  FAILED
  NO_RELEVANT_CONTEXT
  AI_RAG_UNAVAILABLE
}

enum AIRAGQualityClassification {
  HIGH_CONFIDENCE
